+                    self._coevop_scalar(self._coevop_weighted_density()),
+                )
+            )
+            logging.info(
+                "CoEvoP&R custom objective output_scale=%.6E" % output_scale
+            )
+            logging.info(
+                "CoEvoP&R custom objective terms %s"
+                % json.dumps(self.custom_objective_last_terms, sort_keys=True)
+            )
+            logging.info(
+                "CoEvoP&R custom objective components %s"
+                % json.dumps(
+                    {
+                        "call": self.custom_objective_call_count,
+                        "components": components,
+                    },
+                    sort_keys=True,
+                )
+            )
