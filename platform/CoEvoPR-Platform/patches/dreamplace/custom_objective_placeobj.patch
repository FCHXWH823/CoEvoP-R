+    def _coevop_pnorm(self, values):
+        values = values.reshape(-1)
+        values = torch.clamp(values, min=0.0)
+        if values.numel() == 0:
+            return self.wirelength * 0.0
+        eps = values.new_tensor(1e-12)
+        return torch.pow(torch.mean(torch.pow(values + eps, self._COEVOP_PNORM)), 1.0 / self._COEVOP_PNORM)
+
+    def _coevop_soft_route_terms(self):
+        if self._coevop_soft_route_cache is not None:
+            return self._coevop_soft_route_cache
+        pin2net = self.data_collections.pin2net_map.long()
+        num_pins = int(pin2net.numel())
+        num_nets = int(self.placedb.num_nets)
+        if num_pins == 0 or num_nets == 0:
+            zero = self.wirelength * 0.0
+            self._coevop_soft_route_cache = {"route": zero.reshape(1), "pin": zero.reshape(1), "route_long": zero.reshape(1)}
+            return self._coevop_soft_route_cache
+
+        pin_pos = self._coevop_pin_positions()
+        pin_x = pin_pos[:num_pins]
+        pin_y = pin_pos[num_pins:2 * num_pins]
+        finfo = torch.finfo(pin_x.dtype)
+        inf = finfo.max / 4.0
+        max_x = pin_x.new_full((num_nets,), -inf)
+        min_x = pin_x.new_full((num_nets,), inf)
+        max_y = pin_y.new_full((num_nets,), -inf)
+        min_y = pin_y.new_full((num_nets,), inf)
+        max_x.scatter_reduce_(0, pin2net, pin_x, reduce="amax", include_self=True)
+        min_x.scatter_reduce_(0, pin2net, pin_x, reduce="amin", include_self=True)
+        max_y.scatter_reduce_(0, pin2net, pin_y, reduce="amax", include_self=True)
+        min_y.scatter_reduce_(0, pin2net, pin_y, reduce="amin", include_self=True)
+
+        counts = pin_x.new_zeros((num_nets,))
+        counts.scatter_add_(0, pin2net, torch.ones_like(pin_x))
+        valid = counts > 1
+        if hasattr(self.data_collections, "net_mask_ignore_large_degrees"):
+            mask = self.data_collections.net_mask_ignore_large_degrees
+            if mask is not None and int(mask.numel()) == num_nets:
+                valid = valid & mask.bool()
+
+        eps_len = pin_x.new_tensor(max(min(float(self.bin_size_x), float(self.bin_size_y)) * 1e-3, 1e-6))
+        bin_area = pin_x.new_tensor(max(float(self.bin_size_x) * float(self.bin_size_y), 1.0))
+        span_x = torch.clamp(max_x - min_x, min=eps_len)
+        span_y = torch.clamp(max_y - min_y, min=eps_len)
+        net_span = span_x + span_y
+        bbox_area = span_x * span_y + bin_area
+        route_pressure = net_span / torch.sqrt(bbox_area)
+        if hasattr(self.data_collections, "net_weights"):
+            weights = self.data_collections.net_weights
+            if weights is not None and int(weights.numel()) == num_nets:
+                route_pressure = route_pressure * weights
+        pin_pressure = route_pressure * torch.sqrt(torch.clamp(counts, min=1.0))
+        zeros = torch.zeros_like(route_pressure)
+        route_pressure = torch.where(valid, route_pressure, zeros)
+        pin_pressure = torch.where(valid, pin_pressure, zeros)
+        net_span = torch.where(valid, net_span, zeros)
+        if self._coevop_long_route_threshold is None:
+            valid_span = net_span.detach()[valid]
+            if valid_span.numel() == 0:
+                threshold = float(max(float(self.bin_size_x) + float(self.bin_size_y), 1.0))
+            else:
+                threshold = float(torch.mean(valid_span).cpu().item()) * 2.0
+            threshold = max(threshold, 1e-6)
+            temperature = max(threshold * 0.25, 1e-6)
+            self._coevop_long_route_threshold = threshold
+            self._coevop_long_route_temperature = temperature
+            logging.info(
+                "CoEvoP&R route_pressure_long threshold=%.6E temperature=%.6E"
+                % (threshold, temperature)
+            )
+        threshold_t = pin_x.new_tensor(float(self._coevop_long_route_threshold))
+        temperature_t = pin_x.new_tensor(float(self._coevop_long_route_temperature))
+        long_gate = torch.sigmoid((net_span - threshold_t) / temperature_t)
+        route_long_pressure = long_gate * route_pressure
+        if torch.count_nonzero(valid).item() == 0:
+            route_pressure = route_pressure + self.wirelength * 0.0
+            pin_pressure = pin_pressure + self.wirelength * 0.0
+            route_long_pressure = route_long_pressure + self.wirelength * 0.0
+        self._coevop_soft_route_cache = {"route": route_pressure, "pin": pin_pressure, "route_long": route_long_pressure}
+        return self._coevop_soft_route_cache
