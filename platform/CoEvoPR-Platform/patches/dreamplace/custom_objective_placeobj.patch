+    def _coevop_load_custom_objective_spec(self, custom_objective_spec):
+        if not custom_objective_spec:
+            return None
+        if isinstance(custom_objective_spec, dict):
+            spec = custom_objective_spec
+        else:
+            spec_path = os.path.expanduser(str(custom_objective_spec))
+            with open(spec_path, "r") as f:
+                spec = json.load(f)
+        ast = spec.get("ast", spec)
+        self._coevop_validate_custom_ast(ast)
+        components = spec.get("components", {})
+        if components is None:
+            components = {}
+        if not isinstance(components, dict):
+            raise ValueError("CoEvoP&R custom objective components must be a dict")
+        for component_name, component_ast in components.items():
+            if not isinstance(component_name, str):
+                raise ValueError("CoEvoP&R custom objective component names must be strings")
+            self._coevop_validate_custom_ast(component_ast)
+        return {
+            "id": str(spec.get("id", "custom_objective")),
+            "ast": ast,
+            "components": components,
+        }
+
+    def _coevop_validate_custom_ast(self, node, depth=1):
+        if depth > 5:
+            raise ValueError("CoEvoP&R custom objective AST depth exceeds 5")
+        if not isinstance(node, dict):
+            raise ValueError("CoEvoP&R custom objective node must be a dict")
+        op = node.get("op")
+        if op == "term":
+            name = node.get("name")
+            if name not in self._COEVOP_DEPLOYABLE_TERMS:
+                raise ValueError("unsupported CoEvoP&R custom objective term %s" % name)
+            return 1
+        if op == "const":
+            value = float(node.get("value"))
+            if not np.isfinite(value):
+                raise ValueError("non-finite CoEvoP&R custom objective constant")
+            return 1
+        if op not in self._COEVOP_UNARY_OPS | self._COEVOP_BINARY_OPS | self._COEVOP_VARIADIC_OPS:
+            raise ValueError("unsupported CoEvoP&R custom objective op %s" % op)
+        args = node.get("args")
+        if not isinstance(args, list):
+            raise ValueError("CoEvoP&R custom objective op %s requires args" % op)
+        if op in self._COEVOP_UNARY_OPS and len(args) != 1:
+            raise ValueError("CoEvoP&R custom objective op %s requires one arg" % op)
+        if op in self._COEVOP_BINARY_OPS and len(args) != 2:
+            raise ValueError("CoEvoP&R custom objective op %s requires two args" % op)
+        if op in self._COEVOP_VARIADIC_OPS and not (2 <= len(args) <= 4):
+            raise ValueError("CoEvoP&R custom objective op %s requires two to four args" % op)
+        count = 1
+        for child in args:
+            count += self._coevop_validate_custom_ast(child, depth + 1)
+        if count > 12:
+            raise ValueError("CoEvoP&R custom objective AST primitive count exceeds 12")
+        return count
+
+    def _coevop_weighted_density(self):
+        if len(self.placedb.regions) > 0:
+            return self.density_weight.dot(self.density)
+        return self.density * (self.density_factor * self.density_weight).item()
+
+    def _coevop_electric_density(self):
