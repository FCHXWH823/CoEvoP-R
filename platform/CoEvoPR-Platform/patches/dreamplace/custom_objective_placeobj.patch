+    def _coevop_custom_term(self, name):
+        if name == "native_objective":
+            if self._coevop_native_objective is None:
+                raise RuntimeError("CoEvoP&R native_objective requested before native objective was computed")
+            return self._coevop_normalize_term(name, self._coevop_native_objective)
+        if name == "wirelength":
+            return self._coevop_normalize_term(name, self._coevop_wirelength_wawl())
+        if name == "wirelength_wawl":
+            return self._coevop_normalize_term(name, self._coevop_wirelength_wawl())
+        if name == "wirelength_lse":
+            return self._coevop_normalize_term(name, self._coevop_wirelength_lse())
+        if name == "pin_count_weighted_wl":
+            return self._coevop_normalize_term(name, self._coevop_pin_count_weighted_wl())
+        if name == "timing_weighted_wirelength":
+            return self._coevop_normalize_term(name, self.wirelength)
+        if name == "density":
+            return self._coevop_normalize_term(name, self._coevop_electric_density())
+        if name == "density_electric":
+            return self._coevop_normalize_term(name, self._coevop_electric_density())
+        if name == "density_bell":
+            return self._coevop_normalize_term(name, self._coevop_density_bell())
+        if name == "soft_rudy_mean":
+            route_pressure = self._coevop_soft_route_terms()["route"]
+            return self._coevop_normalize_term(name, torch.mean(route_pressure))
+        if name == "soft_rudy_pnorm":
+            route_pressure = self._coevop_soft_route_terms()["route"]
+            return self._coevop_normalize_term(name, self._coevop_pnorm(route_pressure))
+        if name == "route_pressure_long":
+            route_pressure = self._coevop_soft_route_terms()["route_long"]
+            return self._coevop_normalize_term(name, self._coevop_pnorm(route_pressure))
+        if name == "pin_density_pnorm":
+            pin_pressure = self._coevop_soft_route_terms()["pin"]
+            return self._coevop_normalize_term(name, self._coevop_pnorm(pin_pressure))
+        raise ValueError("unsupported CoEvoP&R custom objective term %s" % name)
+
+    def _coevop_eval_custom_ast(self, node):
+        op = node["op"]
+        if op == "term":
+            return self._coevop_custom_term(node["name"])
+        if op == "const":
+            return self.data_collections.pos[0].new_tensor(float(node["value"]))
+        args = [self._coevop_eval_custom_ast(child) for child in node["args"]]
+        if op == "add":
+            result = args[0]
+            for arg in args[1:]:
+                result = result + arg
+            return result
+        if op == "sub":
+            return args[0] - args[1]
+        if op == "mul":
+            result = args[0]
+            for arg in args[1:]:
+                result = result * arg
+            return result
+        if op == "safe_div":
+            eps = self.data_collections.pos[0].new_tensor(1e-6)
+            denom = torch.where(args[1] < 0, torch.minimum(args[1], -eps), torch.maximum(args[1], eps))
+            return args[0] / denom
+        if op == "log1p":
+            return torch.log1p(torch.clamp(args[0], min=-0.999999))
+        if op == "sqrt":
+            return torch.sqrt(torch.clamp(args[0], min=0.0))
+        if op == "square":
+            return args[0] * args[0]
+        if op == "softplus":
+            return F.softplus(args[0])
+        if op == "sigmoid":
+            return torch.sigmoid(args[0])
+        raise ValueError("unsupported CoEvoP&R custom objective op %s" % op)
+
+    def _coevop_scalar(self, value):
+        if isinstance(value, torch.Tensor):
+            return float(value.detach().mean().cpu().item())
+        return float(value)
+
+    def _coevop_eval_custom_components(self):
+        evaluated = {}
+        components = self.custom_objective_spec.get("components", {})
+        for name, component_ast in components.items():
+            try:
+                value = self._coevop_eval_custom_ast(component_ast)
+                if value.numel() != 1:
+                    value = value.sum()
+                evaluated[name] = {
+                    "value": self._coevop_scalar(value),
+                }
+            except Exception as exc:
+                evaluated[name] = {
+                    "error": "%s: %s" % (type(exc).__name__, exc),
+                }
+        self.custom_objective_last_components = evaluated
+        return evaluated
+
+    def _coevop_log_custom_objective(self, result, output_scale):
