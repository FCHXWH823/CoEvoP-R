+
+    _COEVOP_OBSERVABLES = {
+        "iter_frac",
+        "overflow",
+        "hpwl_delta_rate",
+        "gamma_frac",
+        "native_density_weight",
+    }
+    _COEVOP_GRAD_RATIO_PREFIX = "grad_ratio_"
+    _COEVOP_INIT_VALUE_PREFIX = "init_value_"
+    _COEVOP_COMPONENT_GRAD_RATIO_PREFIX = "grad_ratio_component_"
+    _COEVOP_COMPONENT_INIT_VALUE_PREFIX = "init_value_component_"
+
+    def _coevop_is_valid_observable(self, name):
+        if name in self._COEVOP_OBSERVABLES:
+            return True
+        if not isinstance(name, str):
+            return False
+        for prefix in (
+            self._COEVOP_COMPONENT_GRAD_RATIO_PREFIX,
+            self._COEVOP_COMPONENT_INIT_VALUE_PREFIX,
+        ):
+            if name.startswith(prefix):
+                return bool(name[len(prefix):])
+        for prefix in (self._COEVOP_GRAD_RATIO_PREFIX, self._COEVOP_INIT_VALUE_PREFIX):
+            if name.startswith(prefix):
+                return name[len(prefix):] in self._COEVOP_DEPLOYABLE_TERMS
+        return False
+
+    _COEVOP_NET_OBSERVABLES = {"criticality", "span", "fanout"}
+
+    def _coevop_validate_custom_ast(self, node, depth=1, allow_state=None, allow_obs=False, allow_net=False):
+        if depth > 10:
+            raise ValueError("CoEvoP&R custom objective AST depth exceeds 10")
+        if not isinstance(node, dict):
+            raise ValueError("CoEvoP&R custom objective node must be a dict")
+        op = node.get("op")
+        if op == "net":
+            if not allow_net:
+                raise ValueError(
+                    "CoEvoP&R net() nodes are only allowed in net_weight_policy updates"
+                )
+            if node.get("name") not in self._COEVOP_NET_OBSERVABLES:
+                raise ValueError(
+                    "unsupported CoEvoP&R per-net observable %s" % node.get("name")
+                )
+            return 1
+        if op == "term":
+            name = node.get("name")
+            if name not in self._COEVOP_DEPLOYABLE_TERMS:
+                raise ValueError("unsupported CoEvoP&R custom objective term %s" % name)
+            return 1
+        if op == "state":
+            name = node.get("name")
+            if allow_state is None or name not in allow_state:
+                raise ValueError(
+                    "CoEvoP&R state register %s not available in this expression" % name
+                )
+            return 1
+        if op == "obs":
+            name = node.get("name")
+            if not allow_obs:
+                raise ValueError(
+                    "CoEvoP&R obs() nodes are only allowed in state init/update"
+                )
+            if not self._coevop_is_valid_observable(name):
+                raise ValueError("unsupported CoEvoP&R observable %s" % name)
+            return 1
+        if op == "const":
+            value = float(node.get("value"))
+            if not np.isfinite(value):
+                raise ValueError("non-finite CoEvoP&R custom objective constant")
+            return 1
+        if op not in self._COEVOP_UNARY_OPS | self._COEVOP_BINARY_OPS | self._COEVOP_VARIADIC_OPS:
+            raise ValueError("unsupported CoEvoP&R custom objective op %s" % op)
+        args = node.get("args")
+        if not isinstance(args, list):
+            raise ValueError("CoEvoP&R custom objective op %s requires args" % op)
+        if op in self._COEVOP_UNARY_OPS and len(args) != 1:
+            raise ValueError("CoEvoP&R custom objective op %s requires one arg" % op)
+        if op in self._COEVOP_BINARY_OPS and len(args) != 2:
+            raise ValueError("CoEvoP&R custom objective op %s requires two args" % op)
+        if op in self._COEVOP_VARIADIC_OPS and not (2 <= len(args) <= 4):
+            raise ValueError("CoEvoP&R custom objective op %s requires two to four args" % op)
+        count = 1
+        for child in args:
+            count += self._coevop_validate_custom_ast(
+                child, depth + 1, allow_state=allow_state, allow_obs=allow_obs,
+                allow_net=allow_net,
+            )
+        if count > 12:
+            raise ValueError("CoEvoP&R custom objective AST primitive count exceeds 12")
+        return count
+
+    # ------------------------------------------------------------------
+    # DSL v2: scalar state machinery.
+    # Register updates run once per density-weight iteration (NonLinearPlace
+    # calls coevop_update_state). Values are detached device scalars so the
+    # controller cannot backpropagate through history and does not incur a
+    # Python-float round trip on the identity path.
+    # ------------------------------------------------------------------
+
+    def _coevop_state_tensor(self, value):
+        reference = self.data_collections.pos[0]
+        if isinstance(value, torch.Tensor):
+            return value.detach().to(device=reference.device, dtype=reference.dtype).reshape(())
+        return reference.new_tensor(float(value)).reshape(())
+
+    def _coevop_eval_scalar_ast(self, node, state):
+        op = node["op"]
+        if op == "state":
+            return self._coevop_state_tensor(state[node["name"]])
+        if op == "obs":
+            return self._coevop_state_tensor(self._coevop_observable(node["name"]))
+        if op == "const":
+            return self._coevop_state_tensor(node["value"])
+        args = [self._coevop_eval_scalar_ast(child, state) for child in node.get("args", [])]
+        if op == "add":
+            result = args[0]
+            for value in args[1:]:
+                result = result + value
+            return result
+        if op == "sub":
+            return args[0] - args[1]
+        if op == "mul":
+            result = args[0]
+            for value in args[1:]:
+                result = result * value
+            return result
+        if op == "safe_div":
+            eps = args[1].new_tensor(1e-6)
+            denom = args[1]
+            denom = torch.where(denom < 0, torch.minimum(denom, -eps), torch.maximum(denom, eps))
+            return args[0] / denom
+        if op == "log1p":
+            return torch.log1p(torch.clamp(args[0], min=-0.999999))
+        if op == "sqrt":
+            return torch.sqrt(torch.clamp(args[0], min=0.0))
+        if op == "square":
+            return args[0] * args[0]
+        if op == "softplus":
+            return F.softplus(args[0])
+        if op == "sigmoid":
+            return torch.sigmoid(args[0])
+        raise ValueError("unsupported CoEvoP&R scalar op %s" % op)
+
+    def _coevop_observable(self, name):
+        if name == "iter_frac":
+            return min(max(self._coevop_obs_iteration / float(self._coevop_iteration_budget), 0.0), 1.0)
+        if name == "overflow":
+            return float(self._coevop_obs_overflow)
+        if name == "hpwl_delta_rate":
+            return float(self._coevop_obs_hpwl_delta_rate)
+        if name == "gamma_frac":
+            if self._coevop_base_gamma <= 0:
+                return 1.0
+            return float(self.gamma.detach().cpu().item()) / self._coevop_base_gamma
+        if name == "native_density_weight":
+            return (
+                self.density_factor * self.density_weight
+            ).detach().reshape(-1)[0]
+        if name.startswith(self._COEVOP_COMPONENT_GRAD_RATIO_PREFIX):
+            return self._coevop_component_grad_ratio(
+                name[len(self._COEVOP_COMPONENT_GRAD_RATIO_PREFIX):]
+            )
+        if name.startswith(self._COEVOP_COMPONENT_INIT_VALUE_PREFIX):
+            return self._coevop_component_init_value(
+                name[len(self._COEVOP_COMPONENT_INIT_VALUE_PREFIX):]
+            )
+        if name.startswith(self._COEVOP_GRAD_RATIO_PREFIX):
+            return self._coevop_grad_ratio(name[len(self._COEVOP_GRAD_RATIO_PREFIX):])
+        if name.startswith(self._COEVOP_INIT_VALUE_PREFIX):
+            return self._coevop_init_value(name[len(self._COEVOP_INIT_VALUE_PREFIX):])
+        raise ValueError("unsupported CoEvoP&R observable %s" % name)
+
+    def _coevop_component_tensor(self, component_name):
+        components = self.custom_objective_spec.get("components", {})
+        if component_name not in components:
+            raise RuntimeError(
+                "CoEvoP&R component calibration requested unknown component %s"
+                % component_name
+            )
+        value = self._coevop_eval_custom_ast(components[component_name])
+        return value.sum() if value.numel() != 1 else value
+
+    def _coevop_component_init_value(self, component_name):
+        if component_name in self._coevop_component_init_value_cache:
+            return self._coevop_component_init_value_cache[component_name]
+        value = self._coevop_scalar(self._coevop_component_tensor(component_name))
+        if not np.isfinite(value):
+            raise RuntimeError(
+                "CoEvoP&R init_value_component_%s is non-finite" % component_name
+            )
+        self._coevop_component_init_value_cache[component_name] = value
+        logging.info(
+            "CoEvoP&R observable init_value_component_%s=%.6E"
+            % (component_name, value)
+        )
+        return value
+
+    def _coevop_component_grad_ratio(self, component_name):
+        if component_name in self._coevop_component_grad_ratio_cache:
+            return self._coevop_component_grad_ratio_cache[component_name]
+        pos = self._coevop_current_pos
+        if pos is None:
+            raise RuntimeError(
+                "CoEvoP&R component gradient calibration requires objective context"
+            )
+        wl_value = self._coevop_raw_term_value("wirelength_wawl")
+        component_value = self._coevop_component_tensor(component_name)
+        wl_grad = torch.autograd.grad(
+            wl_value, pos, retain_graph=True, allow_unused=True
+        )[0]
+        component_grad = torch.autograd.grad(
+            component_value, pos, retain_graph=True, allow_unused=True
+        )[0]
+        wl_norm = 0.0 if wl_grad is None else float(torch.norm(wl_grad.detach()).cpu().item())
+        component_norm = (
+            0.0
+            if component_grad is None
+            else float(torch.norm(component_grad.detach()).cpu().item())
+        )
+        ratio = wl_norm / max(component_norm, 1e-12)
+        if not np.isfinite(ratio):
+            raise RuntimeError(
+                "CoEvoP&R grad_ratio_component_%s is non-finite" % component_name
+            )
+        self._coevop_component_grad_ratio_cache[component_name] = ratio
+        logging.info(
+            "CoEvoP&R observable grad_ratio_component_%s=%.6E "
+            "(wl_grad=%.6E component_grad=%.6E)"
+            % (component_name, ratio, wl_norm, component_norm)
+        )
+        return ratio
+
+    def _coevop_init_value(self, term_name):
+        if term_name in self._coevop_init_value_cache:
+            return self._coevop_init_value_cache[term_name]
+        if self._coevop_current_pos is None:
+            raise RuntimeError(
+                "CoEvoP&R init_value observables require an objective evaluation context"
+            )
+        value = float(self._coevop_raw_term_value(term_name).detach().cpu().item())
+        if not np.isfinite(value):
+            raise RuntimeError(
+                "CoEvoP&R init_value_%s is non-finite" % term_name
+            )
+        self._coevop_init_value_cache[term_name] = value
+        logging.info(
+            "CoEvoP&R observable init_value_%s=%.6E" % (term_name, value)
+        )
+        return value
+
+    def _coevop_grad_ratio(self, term_name):
+        if term_name in self._coevop_grad_ratio_cache:
+            return self._coevop_grad_ratio_cache[term_name]
+        pos = self._coevop_current_pos
+        if pos is None:
+            raise RuntimeError(
+                "CoEvoP&R grad_ratio observables require an objective evaluation context"
+            )
+        wl_value = self._coevop_raw_term_value("wirelength_wawl")
+        term_value = self._coevop_raw_term_value(term_name)
+        wl_grad = torch.autograd.grad(
+            wl_value, pos, retain_graph=True, allow_unused=True
+        )[0]
+        term_grad = torch.autograd.grad(
+            term_value, pos, retain_graph=True, allow_unused=True
+        )[0]
+        wl_norm = 0.0 if wl_grad is None else float(torch.norm(wl_grad.detach()).cpu().item())
+        term_norm = 0.0 if term_grad is None else float(torch.norm(term_grad.detach()).cpu().item())
+        ratio = wl_norm / max(term_norm, 1e-12)
+        if not np.isfinite(ratio):
+            raise RuntimeError(
+                "CoEvoP&R grad_ratio_%s is non-finite (wl=%.3E term=%.3E)"
+                % (term_name, wl_norm, term_norm)
+            )
+        self._coevop_grad_ratio_cache[term_name] = ratio
+        logging.info(
+            "CoEvoP&R observable grad_ratio_%s=%.6E (wl_grad=%.6E term_grad=%.6E)"
+            % (term_name, ratio, wl_norm, term_norm)
+        )
+        return ratio
+
+    def _coevop_raw_term_value(self, name):
+        value = self._coevop_term_tensor(name)
+        if value.numel() != 1:
+            value = value.sum()
+        return value
+
+    def _coevop_init_state(self):
+        registers = self.custom_objective_spec.get("state", {}).get("registers", {})
+        if not registers:
+            self._coevop_state_initialized = True
+            return
+        state = {}
+        for name, entry in registers.items():
+            value = self._coevop_eval_scalar_ast(entry["init"], state={})
+            if not torch.isfinite(value).all():
+                raise RuntimeError(
+                    "CoEvoP&R state register %s initialized to non-finite value" % name
+                )
+            if name.endswith("_weight") and self._coevop_scalar(value) < 0.0:
+                raise RuntimeError(
+                    "CoEvoP&R physical weight %s initialized negative" % name
+                )
+            state[name] = value.detach()
+        self.custom_state = state
+        self._coevop_state_initialized = True
+        self._coevop_record_state_sample()
+        logging.info(
+            "CoEvoP&R state initialized %s"
+            % json.dumps(
+                {name: self._coevop_scalar(value) for name, value in self.custom_state.items()},
+                sort_keys=True,
+            )
+        )
+        self.coevop_apply_gamma_policy()
+
+    def coevop_sync_native_identity_state(self):
+        """Synchronize the privileged typed identity after native initialization.
+
+        DREAMPlace initializes its effective density coefficient lazily in the
+        first descent step. The typed identity may already have been evaluated
+        while that coefficient was zero for learning-rate estimation, so copy
+        the initialized device scalar at this exact lifecycle boundary.
+        """
+
+        if not self._coevop_native_identity_enabled() or not self._coevop_state_initialized:
+            return
+        if "density_weight" not in self.custom_state:
+            raise RuntimeError("typed native identity is missing density_weight")
+        self.custom_state["density_weight"] = self._coevop_observable(
+            "native_density_weight"
+        ).detach()
+        self._coevop_record_state_sample()
+        logging.info(
+            "CoEvoP&R native identity synchronized density_weight=%.6E"
+            % self._coevop_scalar(self.custom_state["density_weight"])
+        )
+
+    def coevop_update_state(self, cur_metric, iteration):
+        """Advance observables and state registers. Called once per density-weight
+        iteration from NonLinearPlace, mirroring the native update cadence."""
+
+        if self.custom_objective_spec is None:
+            return
+        overflow = getattr(cur_metric, "overflow", None)
+        if overflow is not None:
+            try:
+                self._coevop_obs_overflow = float(
+                    overflow.detach().cpu().reshape(-1)[0].item()
+                    if isinstance(overflow, torch.Tensor)
+                    else float(overflow)
+                )
+            except (TypeError, ValueError):
+                pass
+        hpwl = getattr(cur_metric, "hpwl", None)
+        if hpwl is not None:
+            try:
+                hpwl_value = float(
+                    hpwl.detach().cpu().item() if isinstance(hpwl, torch.Tensor) else float(hpwl)
+                )
+                if self._coevop_obs_prev_hpwl is not None:
+                    self._coevop_obs_hpwl_delta_rate = (
+                        hpwl_value - self._coevop_obs_prev_hpwl
+                    ) / max(self._coevop_obs_prev_hpwl, 1.0)
+                self._coevop_obs_prev_hpwl = hpwl_value
+            except (TypeError, ValueError):
+                pass
+        self._coevop_obs_iteration = int(iteration)
+
+        registers = self.custom_objective_spec.get("state", {}).get("registers", {})
+        if not registers or not self._coevop_state_initialized:
+            return
+        previous = dict(self.custom_state)
+        updated = {}
+        for name, entry in registers.items():
+            value = self._coevop_eval_scalar_ast(entry["update"], state=previous)
+            if not torch.isfinite(value).all():
+                raise RuntimeError(
+                    "CoEvoP&R state register %s updated to non-finite value at iteration %d"
+                    % (name, iteration)
+                )
+            if name.endswith("_weight") and self._coevop_scalar(value) < 0.0:
+                raise RuntimeError(
+                    "CoEvoP&R physical weight %s became negative at iteration %d"
+                    % (name, iteration)
+                )
+            updated[name] = value.detach()
+        self.custom_state = updated
+        self._coevop_record_state_sample()
+
+    def coevop_apply_gamma_policy(self):
+        state_spec = self.custom_objective_spec.get("state", {}) if self.custom_objective_spec else {}
+        if state_spec.get("interface") != self._COEVOP_TYPED_POLICY_INTERFACE:
+            return
+        if state_spec.get("control") == "native_identity":
+            return
+        if "gamma_scale" not in self.custom_state:
+            raise RuntimeError("typed CoEvoP&R policy is missing gamma_scale")
+        scale = self._coevop_scalar(self.custom_state["gamma_scale"])
+        if not np.isfinite(scale):
+            raise RuntimeError("typed CoEvoP&R gamma_scale is non-finite")
+        if scale < self._COEVOP_GAMMA_SCALE_MIN or scale > self._COEVOP_GAMMA_SCALE_MAX:
+            raise RuntimeError(
+                "typed CoEvoP&R gamma_scale %.6E is outside DREAMPlace bounds [%.6E, %.6E]"
+                % (scale, self._COEVOP_GAMMA_SCALE_MIN, self._COEVOP_GAMMA_SCALE_MAX)
+            )
+        with torch.no_grad():
+            self.gamma.data.fill_(self._coevop_base_gamma * scale)
+        if self._coevop_obs_iteration % max(self.custom_objective_log_interval, 1) == 0:
+            logging.info(
+                "CoEvoP&R gamma policy base=%.6E scale=%.6E effective=%.6E"
+                % (self._coevop_base_gamma, scale, self._coevop_scalar(self.gamma))
+            )
+
+    def _coevop_eval_net_ast(self, node, net_observables):
+        op = node["op"]
+        if op == "net":
+            return net_observables[node["name"]]
+        if op == "state":
+            return self._coevop_state_tensor(self.custom_state[node["name"]])
+        if op == "obs":
+            return self._coevop_state_tensor(self._coevop_observable(node["name"]))
+        if op == "const":
+            return self._coevop_state_tensor(node["value"])
+        args = [self._coevop_eval_net_ast(child, net_observables) for child in node.get("args", [])]
+        if op == "add":
+            result = args[0]
+            for value in args[1:]:
+                result = result + value
+            return result
+        if op == "sub":
+            return args[0] - args[1]
+        if op == "mul":
+            result = args[0]
+            for value in args[1:]:
+                result = result * value
+            return result
+        if op == "safe_div":
+            eps = args[1].new_tensor(1e-6)
+            denom = torch.where(args[1] < 0, torch.minimum(args[1], -eps), torch.maximum(args[1], eps))
+            return args[0] / denom
+        if op == "log1p":
+            return torch.log1p(torch.clamp(args[0], min=-0.999999))
+        if op == "sqrt":
+            return torch.sqrt(torch.clamp(args[0], min=0.0))
+        if op == "square":
+            return args[0] * args[0]
+        if op == "softplus":
+            return F.softplus(args[0])
+        if op == "sigmoid":
+            return torch.sigmoid(args[0])
+        raise ValueError("unsupported CoEvoP&R net policy op %s" % op)
+
+    def coevop_update_net_weights(self, timing_op, previous_net_weights, iteration):
+        policy = self.custom_objective_spec.get("net_weight_policy") if self.custom_objective_spec else None
+        if not policy:
+            return
+        self._coevop_timing_update_count += 1
+        if str(policy.get("control", "generated")) == "native_identity":
+            logging.info("CoEvoP&R timing identity preserved native DREAMPlace net weights")
+            logging.info(
+                "CoEvoP&R timing policy %s"
+                % json.dumps(
+                    {
+                        "control": "native_identity",
+                        "iteration": int(iteration),
+                        "update_count": self._coevop_timing_update_count,
+                    },
+                    sort_keys=True,
+                )
+            )
+            return
+        cadence = max(int(policy.get("cadence", 1) or 1), 1)
+        self.placedb.net_weights[:] = previous_net_weights
+        if self._coevop_timing_update_count % cadence != 0:
+            return
+
+        reference = self.data_collections.pos[0]
+        num_nets = int(self.placedb.num_nets)
+        criticality = torch.as_tensor(
+            timing_op.net_criticality, dtype=reference.dtype, device=reference.device
+        ).reshape(-1)[:num_nets]
+        route_terms = self._coevop_soft_route_terms()
+        span = route_terms["span"].detach().to(reference.device).reshape(-1)[:num_nets]
+        starts = self.data_collections.flat_net2pin_start_map
+        fanout = (starts[1:] - starts[:-1]).to(device=reference.device, dtype=reference.dtype)[:num_nets]
+
+        def normalize(values):
+            values = torch.clamp(values, min=0.0)
+            return values / torch.clamp(torch.max(values), min=1e-12)
+
+        net_observables = {
+            "criticality": normalize(criticality),
+            "span": normalize(span),
+            "fanout": normalize(fanout),
+        }
+        multiplier = self._coevop_eval_net_ast(policy["update"], net_observables)
+        if multiplier.numel() == 1:
+            multiplier = multiplier.expand(num_nets)
+        if int(multiplier.numel()) != num_nets or not torch.isfinite(multiplier).all():
+            raise RuntimeError("CoEvoP&R timing policy produced invalid per-net multipliers")
+        configured_max_weight = max(float(self.placedb.max_net_weight), 1.0)
+        derived_bounds = [0.0, configured_max_weight]
+        multiplier_bounds = policy.get("multiplier_clip", derived_bounds)
+        weight_bounds = policy.get("weight_clip", derived_bounds)
+        multiplier = torch.clamp(
+            multiplier, min=float(multiplier_bounds[0]), max=float(multiplier_bounds[1])
+        )
+        previous = torch.as_tensor(
+            previous_net_weights, dtype=reference.dtype, device=reference.device
+        ).reshape(-1)[:num_nets]
+        updated = torch.clamp(
+            previous * multiplier,
+            min=float(weight_bounds[0]),
+            max=float(weight_bounds[1]),
+        )
+        if not torch.isfinite(updated).all():
+            raise RuntimeError("CoEvoP&R timing policy produced non-finite net weights")
+        updated_cpu = updated.detach().cpu().numpy()
+        self.placedb.net_weights[:num_nets] = updated_cpu
+        if self.data_collections.net_weights is not None:
+            self.data_collections.net_weights[:num_nets].copy_(updated)
+        logging.info(
+            "CoEvoP&R timing policy %s"
+            % json.dumps(
+                {
+                    "iteration": int(iteration),
+                    "update_count": self._coevop_timing_update_count,
+                    "criticality_mean": self._coevop_scalar(net_observables["criticality"]),
+                    "multiplier_min": float(torch.min(multiplier).detach().cpu().item()),
+                    "multiplier_mean": self._coevop_scalar(multiplier),
+                    "multiplier_max": float(torch.max(multiplier).detach().cpu().item()),
+                    "weight_min": float(torch.min(updated).detach().cpu().item()),
+                    "weight_mean": self._coevop_scalar(updated),
+                    "weight_max": float(torch.max(updated).detach().cpu().item()),
+                },
+                sort_keys=True,
+            )
+        )
+
+    def _coevop_record_state_sample(self):
+        if not self.custom_state:
+            return
+        interval = max(self.custom_objective_log_interval, 1)
+        if self._coevop_obs_iteration % interval == 0 or not self.custom_state_trajectory:
+            sample = {"iteration": self._coevop_obs_iteration}
+            sample.update(
+                {name: self._coevop_scalar(value) for name, value in self.custom_state.items()}
+            )
+            sample["gamma"] = self._coevop_scalar(self.gamma)
+            sample["overflow"] = float(self._coevop_obs_overflow)
+            self.custom_state_trajectory.append(sample)
+            logging.info(
+                "CoEvoP&R state sample %s" % json.dumps(sample, sort_keys=True)
+            )
+
+    def _coevop_weighted_density(self):
+        if len(self.placedb.regions) > 0:
+            return self.density_weight.dot(self.density)
+        return self.density * (self.density_factor * self.density_weight).item()
+
+    def _coevop_electric_density(self):
+        return self.density
+
+    def _coevop_wirelength_wawl(self):
+        if self.global_place_params.get("wirelength") == "weighted_average":
+            return self.wirelength
+        return self._coevop_wirelength_wawl_op(self._coevop_current_pos)
+
+    def _coevop_wirelength_lse(self):
+        return self._coevop_wirelength_lse_op(self._coevop_current_pos)
+
+    def _coevop_pin_count_weighted_wl(self):
+        return self._coevop_pin_count_weighted_wl_op(self._coevop_current_pos)
+
+    def _coevop_density_bell(self):
+        return self._coevop_density_bell_op(self._coevop_current_pos)
+
+    def _coevop_normalize_term(self, name, value):
+        if value.numel() != 1:
+            value = value.sum()
+        if name not in self.custom_objective_term_scales:
+            scale = max(abs(float(value.detach().cpu().item())), 1.0)
+            if name in {"density", "density_electric", "density_bell"} and scale <= 1.0:
+                scale = max(abs(float(self.wirelength.detach().cpu().item())), 1.0)
+            self.custom_objective_term_scales[name] = scale
+            logging.info("CoEvoP&R custom objective term_scale %s=%.6E" % (name, scale))
+        normalized = value / self.custom_objective_term_scales[name]
+        self.custom_objective_last_terms[name] = {
+            "raw": self._coevop_scalar(value),
+            "normalized": self._coevop_scalar(normalized),
+        }
+        return normalized
+
+    def _coevop_output_scale(self):
+        wirelength_scale = max(abs(float(self.wirelength.detach().cpu().item())), 1.0)
+        if "native_objective" in self.custom_objective_term_scales:
+            return self.custom_objective_term_scales["native_objective"]
+        for wl_name in ("wirelength", "wirelength_wawl", "wirelength_lse", "pin_count_weighted_wl"):
+            if wl_name in self.custom_objective_term_scales:
+                return self.custom_objective_term_scales[wl_name]
+        return wirelength_scale
+
+    def _coevop_density_pnorm(self):
+        density = self._coevop_weighted_density()
+        if density.numel() == 1:
+            return torch.clamp(density, min=0.0)
+        return self._coevop_pnorm(torch.clamp(density.reshape(-1), min=0.0))
+
+    def _coevop_pin_positions(self):
+        pos = self._coevop_current_pos
+        if pos is None:
+            pos = self.data_collections.pos[0]
+        return self.op_collections.pin_pos_op(pos)
+
+    def _coevop_pnorm(self, values):
+        values = values.reshape(-1)
+        values = torch.clamp(values, min=0.0)
+        if values.numel() == 0:
+            return self.wirelength * 0.0
+        eps = values.new_tensor(1e-12)
+        return torch.pow(torch.mean(torch.pow(values + eps, self._COEVOP_PNORM)), 1.0 / self._COEVOP_PNORM)
+
+    def _coevop_soft_route_terms(self):
+        if self._coevop_soft_route_cache is not None:
+            return self._coevop_soft_route_cache
+        pin2net = self.data_collections.pin2net_map.long()
+        num_pins = int(pin2net.numel())
+        num_nets = int(self.placedb.num_nets)
+        if num_pins == 0 or num_nets == 0:
+            zero = self.wirelength * 0.0
+            self._coevop_soft_route_cache = {
+                "route": zero.reshape(1),
+                "pin": zero.reshape(1),
+                "route_long": zero.reshape(1),
+                "span": zero.reshape(1),
+            }
+            return self._coevop_soft_route_cache
+
+        pin_pos = self._coevop_pin_positions()
+        pin_x = pin_pos[:num_pins]
+        pin_y = pin_pos[num_pins:2 * num_pins]
+        finfo = torch.finfo(pin_x.dtype)
+        inf = finfo.max / 4.0
+        max_x = pin_x.new_full((num_nets,), -inf)
+        min_x = pin_x.new_full((num_nets,), inf)
+        max_y = pin_y.new_full((num_nets,), -inf)
+        min_y = pin_y.new_full((num_nets,), inf)
+        max_x.scatter_reduce_(0, pin2net, pin_x, reduce="amax", include_self=True)
+        min_x.scatter_reduce_(0, pin2net, pin_x, reduce="amin", include_self=True)
+        max_y.scatter_reduce_(0, pin2net, pin_y, reduce="amax", include_self=True)
+        min_y.scatter_reduce_(0, pin2net, pin_y, reduce="amin", include_self=True)
+
+        counts = pin_x.new_zeros((num_nets,))
+        counts.scatter_add_(0, pin2net, torch.ones_like(pin_x))
+        valid = counts > 1
