+                    )
+                self._coevop_validate_custom_ast(
+                    entry["init"], allow_state=set(), allow_obs=True
+                )
+                self._coevop_validate_custom_ast(
+                    entry["update"], allow_state=set(registers), allow_obs=True
+                )
+            if state_interface == self._COEVOP_TYPED_POLICY_INTERFACE:
+                names = set(registers)
+                missing = self._COEVOP_TYPED_REQUIRED_SLOTS - names
+                unknown = names - (
+                    self._COEVOP_TYPED_REQUIRED_SLOTS | self._COEVOP_TYPED_OPTIONAL_SLOTS
+                )
+                if missing or unknown:
+                    raise ValueError(
+                        "typed CoEvoP&R policy slots invalid: missing=%s unknown=%s"
+                        % (sorted(missing), sorted(unknown))
+                    )
+        self._coevop_validate_custom_ast(ast, allow_state=set(registers), allow_obs=False)
+        components = spec.get("components", {})
+        if components is None:
+            components = {}
+        if not isinstance(components, dict):
+            raise ValueError("CoEvoP&R custom objective components must be a dict")
+        for component_name, component_ast in components.items():
+            if not isinstance(component_name, str):
+                raise ValueError("CoEvoP&R custom objective component names must be strings")
+            self._coevop_validate_custom_ast(
