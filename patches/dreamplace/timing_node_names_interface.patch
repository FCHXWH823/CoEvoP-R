+// CoEvoP&R timing-collateral bridge:
+//
+// Some ChipBench/DREAMPlace timing packages use DEF-style hierarchical net
+// names in the placement database, e.g. "icache_1/lce/_02063_", while the
+// OpenTimer Verilog loaded for timing contains synthesized identifier-safe
+// names, e.g. "icache_1_lce__02063_". The original DREAMPlace timing path
+// asserts when a placement net/pin is absent from the timer. For timing-proxy
+// feedback, treat these as collateral gaps: resolve common aliases first and
+// skip still-unmatched nets rather than aborting the whole placement run.
+static inline std::string coevopTimingAlias(std::string name) {
+  name.erase(std::remove(name.begin(), name.end(), '\\'), name.end());
+  std::replace(name.begin(), name.end(), '/', '_');
+  return name;
+}
+
+static inline std::string coevopTimingDotAlias(std::string name) {
+  name.erase(std::remove(name.begin(), name.end(), '\\'), name.end());
+  std::replace(name.begin(), name.end(), '/', '.');
+  return name;
+}
+
+static inline void coevopInsertTimingAlias(
+    std::unordered_map<std::string, std::string>& aliases,
+    const std::string& alias,
+    const std::string& canonical) {
+  if (!alias.empty()) aliases.emplace(alias, canonical);
+}
+
+template <typename MapT>
+static inline std::unordered_map<std::string, std::string>
+coevopBuildTimingAliasMap(const MapT& objects) {
+  std::unordered_map<std::string, std::string> aliases;
+  aliases.reserve(objects.size() * 12);
+  for (const auto& kv : objects) {
+    const auto& canonical = kv.first;
+    coevopInsertTimingAlias(aliases, canonical, canonical);
+    coevopInsertTimingAlias(aliases, coevopTimingAlias(canonical), canonical);
+    coevopInsertTimingAlias(aliases, coevopTimingDotAlias(canonical), canonical);
+
+    // OpenTimer cell pins are stored as "instance:pin". DREAMPlace/DEF pin
+    // names commonly arrive as "instance/pin", and hierarchical instance
+    // names may also have been flattened from "/" to "_" in timing Verilog.
+    // Add all common separator variants so the RC-tree builder does not drop
+    // almost every net as pin-incomplete.
+    const auto colon = canonical.rfind(':');
+    if (colon != std::string::npos) {
+      const auto inst = canonical.substr(0, colon);
+      const auto pin = canonical.substr(colon + 1);
+      const auto inst_flat = coevopTimingAlias(inst);
+      const auto inst_dot = coevopTimingDotAlias(inst);
+      coevopInsertTimingAlias(aliases, inst + "/" + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst + "." + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_flat + ":" + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_flat + "/" + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_flat + "." + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_dot + ":" + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_dot + "/" + pin, canonical);
+      coevopInsertTimingAlias(aliases, inst_dot + "." + pin, canonical);
+    }
+  }
+  return aliases;
+}
+
+static inline std::string coevopResolveTimingName(
+    const std::unordered_map<std::string, std::string>& aliases,
+    const std::string& name) {
+  auto iter = aliases.find(name);
+  if (iter != aliases.end()) return iter->second;
+  iter = aliases.find(coevopTimingAlias(name));
+  if (iter != aliases.end()) return iter->second;
+  iter = aliases.find(coevopTimingDotAlias(name));
+  if (iter != aliases.end()) return iter->second;
+  auto slash = name.rfind('/');
+  if (slash != std::string::npos) {
+    auto candidate = coevopTimingAlias(name.substr(0, slash)) + ":" +
+                     name.substr(slash + 1);
+    iter = aliases.find(candidate);
+    if (iter != aliases.end()) return iter->second;
+  }
+  return std::string();
+}
+
+static inline std::string coevopResolvePinName(
+    const std::unordered_map<std::string, std::string>& aliases,
+    const std::vector<std::string>& pin_names,
+    const std::vector<std::string>& node_names,
+    const int* pin2node,
+    int pin) {
+  const std::string local = pin_names[pin];
+  auto resolved = coevopResolveTimingName(aliases, local);
+  if (!resolved.empty()) return resolved;
+
+  int node = pin2node[pin];
+  if (node >= 0 && static_cast<size_t>(node) < node_names.size()) {
+    const std::string inst = node_names[node];
+    const std::string candidates[] = {
+        inst + ":" + local,
+        coevopTimingAlias(inst) + ":" + local,
+        coevopTimingDotAlias(inst) + ":" + local,
+        inst + "/" + local,
+        inst + "." + local,
+    };
+    for (const auto& candidate : candidates) {
+      resolved = coevopResolveTimingName(aliases, candidate);
+      if (!resolved.empty()) return resolved;
+    }
+  }
+  return std::string();
+}
+
